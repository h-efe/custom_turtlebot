[Unit]
Description=Logitech F710 joystick reader (joy_node)
After=network.target

[Service]
Type=simple
User=pi4
Group=pi4
Environment=HOME=/home/pi4
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && exec ros2 run joy joy_node'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
