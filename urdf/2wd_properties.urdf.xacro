<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Degerler gercek mezura olcumleriyle belirlenmistir (Waffle sasi) -->
  <xacro:property name="base_length" value="0.27" />
  <xacro:property name="base_width" value="0.27" />
  <xacro:property name="base_height" value="0.003" />
  <xacro:property name="base_mass" value="1" />

  <xacro:property name="wheel_radius" value="0.0325" /> <!-- 6.5cm cap olcumu -->
  <xacro:property name="wheel_width" value="0.017" />
  <xacro:property name="wheel_pos_x" value="0.085" /> <!-- ana teker on kenardan 5cm, merkeze gore +8.5cm -->
  <xacro:property name="wheel_pos_y" value="0.1565" /> <!-- teker disi 33cm - 1.7cm genislik = 31.3cm merkez-merkez -->
  <xacro:property name="wheel_pos_z" value="0.023" />
  <xacro:property name="wheel_mass" value=".1" />
  <xacro:property name="wheel_torque" value="20" />
  <xacro:property name="front_caster_wheel" value="false" /> <!-- onde caster yok, ikisi de arkada -->
  <xacro:property name="rear_caster_wheel" value="true" />

  <xacro:property name="laser_pose">
    <origin xyz="0.035 0 0.15" rpy="0 0 0"/> <!-- on kenardan 10cm, ortali, yerden 15cm -->
  </xacro:property>

  <xacro:property name="depth_sensor_pose">
    <origin xyz="0.14 0.0 0.045" rpy="0 0 0"/>
  </xacro:property>

  <xacro:property name="rear_camera_sensor_pose">
    <origin xyz="-0.14 0.0 0.045" rpy="0 0 3.14159"/>
  </xacro:property>

</robot>
